{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├ ",
      "showPeCoreCount": true,
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├ ",
      "detectionMethod": "pci",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├ 󱄄",
      "keyColor": "green"
    },
    {
      "type": "bios",
      "key": "│ ├ 󰍛",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ ├ 󰋊",
      "keyColor": "green",
      "percent": {
        "type": [
          "bar-monochrome",
          "num"
        ]
      }
    },
    {
      "type": "memory",
      "key": "│ ├ ",
      "keyColor": "green",
      "percent": {
        "type": [
          "bar-monochrome",
          "num"
        ]
      }
    },
    {
      "type": "swap",
      "key": "│ ├ 󰓡",
      "keyColor": "green",
      "percent": {
        "type": [
          "bar-monochrome",
          "num"
        ]
      }
    },
    {
      "type": "sound",
      "key": "│ ├ 󰓃",
      "keyColor": "green"
    },
    {
      "type": "battery",
      "key": "└ └ ",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "│ ├ ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├ ",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ ├ ",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "│ ├ 󰞷",
      "keyColor": "blue"
    },
    {
      "type": "editor",
      "key": "│ ├ ",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ ├ 󰏖",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "│ ├ 󰉼",
      "keyColor": "blue"
    },
    {
      "type": "netio",
      "key": "│ ├ 󰓅",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "key": "│ ├ 󰸌",
      "keyColor": "blue",
      "format": "\u001b[31m● \u001b[32m● \u001b[33m● \u001b[34m● \u001b[35m● \u001b[36m● \u001b[37m● \u001b[38m●"
    },
    {
      "type": "terminalfont",
      "key": "└ └ ",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime────────────────────────┐"
    },
    {
      "type": "disk",
      "key": "󱦟 OS Age",
      "keyColor": "magenta",
      "folders": "/",
      "format": "{years} yr {days-of-year} days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "localip",
      "key": "󰩟 Local IP",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
